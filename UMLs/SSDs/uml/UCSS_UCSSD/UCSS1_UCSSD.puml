@startuml
'https://plantuml.com/sequence-diagram

autonumber

autonumber

actor "User" as user
participant ":System" as sys

user -> sys: Click on the settings icon
user <-- sys: Show settings page

user -> sys: Click on the profile icon placeholder
user <-- sys: Opens the user gallery

user -> sys: Chooses the image
user <-- sys: Saves the image on the app
user <-- sys: Displays the image on the placeholder



@enduml