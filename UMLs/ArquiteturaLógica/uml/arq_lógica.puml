@startuml
'https://plantuml.com/component-diagram

left to right direction

hide circle
allowmixing
title Logical Architecture

package com.lvhm.covertocover as system_package {
    class "Main Activity" as main_activity
    package "Adapter" as adapter
    package "API" as api
    package "DataModels" as datamodels
    package "Exceptions" as exceptions
    package "Models" as models
    package "Repo" as repo
    package "Service" as service
    package "ViewHolder" as viewholder

    main_activity ..> service
    service ..> adapter
    service ..> models
    service ..> api
    exceptions ..> models
    models ..> api
    repo ..> models
    datamodels ..> api
    viewholder ..> adapter
}
@enduml
